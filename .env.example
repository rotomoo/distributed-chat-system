# docker compose 가 읽는 secret. 이 파일을 .env 로 복사해서 채운다 (.env 는 git 에 올리지 않는다)
#   cp .env.example .env
#
# jasypt 키. 값에 ENC(...) 를 쓰고 싶으면 이 키로 암호화한 값을 넣으면 된다
JASYPT_ENCRYPTOR_PASSWORD=
# 앱이 쓰는 mysql 계정(chat)의 비밀번호. mysql 컨테이너 최초 기동 시 이 값으로 계정이 생성된다
DB_PASSWORD=
# 웹 푸시 VAPID 키 (비우면 notification-consumer 가 처음 뜰 때 만들어 MySQL 에 저장하고 계속 쓴다. 운영은 지정 권장)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
