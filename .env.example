# docker compose 가 읽는 비밀값. 이 파일을 .env 로 복사해서 채운다 (.env 는 git 에 올리지 않는다)
#   cp .env.example .env
#
# jasypt 키. 값에 ENC(...) 를 쓰고 싶으면 이 키로 암호화한 값을 넣으면 된다
JASYPT_ENCRYPTOR_PASSWORD=
# mysql root (앱은 쓰지 않음)
MYSQL_ROOT_PASSWORD=
# 앱이 쓰는 mysql 계정 (chat 스키마 전용, 컨테이너 최초 기동 시 생성)
DB_USERNAME=chat
DB_PASSWORD=
